archetype Animal {
    fn void breathe();
    fn void move();
}

class Dog
{
    string name;
}

impl Dog {

    fn string get_name() {
        return self.name;
    }

    fn void bark() {
        writeln("Wooof!");
    }
}

impl Animal for Dog {
    fn void move() {
        writeln("dog is moving");
    }

    fn void breath() {
        writeln("dog is breathing");
    }
}

class Chiwawa extends Dog {}

impl Chiwawa {
    fn void assault() {
        writeln("Chiwawa asaults a person because they have anger issues");
    }
}


fn void main() {
    Animal *animal = new Dog("Samo");
    animal.move();
    animal.breath();
    Dog *dog = dynamic_cast(animal);
    writeln("Dog is named: {}", dog.get_name());
}
